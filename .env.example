# Copy to .env and fill with your Supabase project values
# (Dashboard -> Project Settings -> API)
VITE_SUPABASE_PROJECT_ID="your-project-id"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-key"
VITE_SUPABASE_URL="https://your-project-id.supabase.co"

# Supabase Edge Function secrets, set with:
# supabase secrets set MS_CLIENT_ID="..." MS_CLIENT_SECRET="..."
MS_CLIENT_ID="your-entra-app-client-id"
MS_CLIENT_SECRET="your-entra-app-client-secret"
